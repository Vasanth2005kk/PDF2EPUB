# Copy to .env and adjust. Never commit the real .env.

# development | production | testing
APP_ENV=development
# Required in production: a long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me

# Where uploads, job state and generated EPUBs are stored (default: ./storage)
# STORAGE_DIR=/var/lib/pdf2epub

# Limits
MAX_UPLOAD_MB=100
MAX_PAGES=2000
CONVERSION_TIMEOUT_SECONDS=900
MAX_CONCURRENT_JOBS=2
MAX_IMAGE_PIXELS=60000000

# OCR (Tesseract). Leave TESSERACT_CMD empty to use `tesseract` from PATH.
OCR_DPI=300
OCR_PAGE_TIMEOUT_SECONDS=120
# TESSERACT_CMD=/usr/bin/tesseract

# Optional EPUBCheck validation: path to epubcheck.jar (needs Java) or an `epubcheck` executable.
# EPUBCHECK_PATH=/opt/epubcheck/epubcheck.jar
EPUBCHECK_TIMEOUT_SECONDS=180

# Cleanup of temporary job files
JOB_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300
ENABLE_BACKGROUND_CLEANUP=true

LOG_LEVEL=INFO
# Development server only
# HOST=127.0.0.1
# PORT=5000
